{
  "name": "travel-lite-kansai-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "test:integrity": "node scripts/check-item-ids.mjs trip.json",
    "serve": "python3 -m http.server 8000",
    "test:transport": "node --test tests/transport-data.test.mjs",
    "test:pilgrimage": "node --test tests/pilgrimage.test.mjs",
    "test:timeline": "node --test tests/chronological-timeline.test.mjs && node scripts/check-chronological-timeline.mjs trip.json",
    "test:uiux": "node --test tests/uiux-contract.test.mjs",
    "test:contracts": "npm run lint:uiux && npm run test:uiux && npm run test:timeline && npm run test:journey",
    "test:trip-widgets": "node --test tests/date-weather-flight.test.mjs",
    "lint:uiux": "node --test tests/uiux-lint.test.mjs && node scripts/lint-uiux.mjs",
    "test:uiux:geometry": "playwright test tests/uiux-safe-inset.spec.mjs --project=chromium",
    "test:journey": "node --test tests/journey-groups.test.mjs",
    "test:journey:browser": "playwright test tests/journey-timeline.spec.mjs --project=chromium"
  }
}
